            "matcher": { "id": "byName", "options": "KEDA Scale Trigger (30 msgs)" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [4, 4], "fill": "dash" } },
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
