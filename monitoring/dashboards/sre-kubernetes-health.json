      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "editorMode": "code",
          "expr": "sum(rabbitmq_detailed_queue_messages{queue=\"payment.order_created.queue\"}) or sum(rabbitmq_queue_messages)",
          "legendFormat": "Queue Depth (payment.order_created.queue)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "editorMode": "code",
          "expr": "vector(30)",
          "legendFormat": "KEDA Scale Trigger (30 msgs)",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "editorMode": "code",
          "expr": "kube_deployment_status_replicas{deployment=~\"payment-service.*\"} or count(up{job=\"payment-service\"})",
