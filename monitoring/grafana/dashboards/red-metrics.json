      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "clamp_max((1 - (sum(rate(http_requests_total{service=~\"$service\", status_code=~\"5..\"}[5m])) or vector(0)) / (sum(rate(http_requests_total{service=~\"$service\"}[5m])) > 0 or vector(1))) * 100, 100)",
          "instant": false,
          "range": true,
          "refId": "A"
