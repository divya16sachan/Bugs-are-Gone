# Environment Configuration

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# Service Ports
USER_SERVICE_PORT=3001
CATALOG_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
PAYMENT_SERVICE_PORT=3004

# Service URLs (for inter-service HTTP communication)
USER_SERVICE_URL=http://localhost:3001
CATALOG_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004

# PostgreSQL Database URLs (Per-Service Isolated Databases)
DATABASE_URL_USER=postgresql://postgres:postgres@localhost:5432/user_db?schema=public
DATABASE_URL_CATALOG=postgresql://postgres:postgres@localhost:5432/catalog_db?schema=public
DATABASE_URL_ORDER=postgresql://postgres:postgres@localhost:5432/order_db?schema=public
DATABASE_URL_PAYMENT=postgresql://postgres:postgres@localhost:5432/payment_db?schema=public

# Redis (Product cache-aside only)
REDIS_URL=redis://localhost:6379

# RabbitMQ (Cross-service asynchronous messaging)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=ecommerce

# Monitoring & Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3010
ALERTMANAGER_PORT=9093
SLACK_WEBHOOK_URL=https://slack.example.com/webhook/YOUR_WORKSPACE_TOKEN

# Logging Level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info
