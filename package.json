{
  "name": "ecom-sre-platform",
  "version": "1.0.0",
  "description": "Distributed E-Commerce Microservices Platform demonstrating SRE Observability, Self-Healing, and Auto-Scaling",
  "private": true,
  "workspaces": [
    "backend/shared",
    "backend/services/*"
  ],
  "scripts": {
    "dev:all": "node scripts/run_all_services.mjs",
    "dev:user": "npm --workspace=user-service run dev",
    "dev:catalog": "npm --workspace=catalog-service run dev",
    "dev:order": "npm --workspace=order-service run dev",
    "dev:payment": "npm --workspace=payment-service run dev",
    "build": "npm run --workspaces --if-present build",
    "prisma:generate": "npm run --workspaces --if-present prisma:generate",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "smoke-test": "node scripts/smoke_test.js",
    "load:test": "node load/experiment_runner.js",
    "load:1k": "node load/experiment_runner.js --concurrency 1000 --duration 20",
    "chaos": "node chaos/chaos_controller.js",
    "scenario": "node experiments/run_scenario.js",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
